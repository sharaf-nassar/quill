{
  "identifier": "com.quilltoolkit.app.dev",
  "build": {
    "beforeDevCommand": "node scripts/dev-handoff.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Quill",
        "width": 360,
        "height": 800,
        "minWidth": 320,
        "minHeight": 200,
        "alwaysOnTop": false,
        "transparent": true,
        "decorations": false,
        "resizable": true,
        "focus": false
      }
    ]
  }
}
