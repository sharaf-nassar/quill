{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quill.local/schemas/retention-private-manifest-1.json",
  "title": "Private retention corpus study manifest",
  "description": "Exact local evidence. Never commit, publish, or transfer without privacy review.",
  "type": "object",
  "required": [
    "schema_version", "lifecycle", "created_at", "approval", "source",
    "source_after_reads", "profile_backup", "cleanup_disposition", "matrix"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "lifecycle": { "enum": ["profiled", "replay_complete", "cancelled", "failed"] },
    "created_at": { "type": "string", "format": "date-time" },
    "approval": { "$ref": "#/$defs/approval" },
    "source": { "$ref": "#/$defs/inventory" },
    "source_after_reads": { "$ref": "#/$defs/inventory" },
    "profile_backup": { "$ref": "#/$defs/backup" },
    "cleanup_disposition": { "type": "string", "minLength": 1 },
    "matrix": {
      "type": "array",
      "items": { "$ref": "#/$defs/observation" }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "lifecycle": { "const": "profiled" } }, "required": ["lifecycle"] },
      "then": { "properties": { "matrix": { "maxItems": 0 } } },
      "else": { "properties": { "matrix": { "$ref": "#/$defs/replay_matrix" } } }
    }
  ],
  "$defs": {
    "replay_matrix": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/observation" },
      "allOf": [
        {
          "contains": {
            "properties": { "archive_mode": { "const": "archive_off" }, "cache_state": { "const": "controlled_warm" } },
            "required": ["archive_mode", "cache_state"]
          },
          "minContains": 3,
          "maxContains": 3
        },
        {
          "contains": {
            "properties": { "archive_mode": { "const": "archive_off" }, "cache_state": { "const": "best_effort_cold" } },
            "required": ["archive_mode", "cache_state"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": { "archive_mode": { "const": "archive_on" }, "cache_state": { "const": "controlled_warm" } },
            "required": ["archive_mode", "cache_state"]
          },
          "minContains": 3,
          "maxContains": 3
        },
        {
          "contains": {
            "properties": { "archive_mode": { "const": "archive_on" }, "cache_state": { "const": "best_effort_cold" } },
            "required": ["archive_mode", "cache_state"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "approval": {
      "type": "object",
      "required": [
        "corpus_label", "owner_or_custodian", "authorized_operator", "reviewers",
        "approved_by", "approved_at", "expires_at", "revoked",
        "allow_scratch_replay", "allow_aggregate_publication", "cleanup_deadline",
        "independence_rationale", "fixed_utc_anchor", "retention_window_days",
        "quill_stopped_acknowledged", "concurrent_load_policy", "prior_prune_state",
        "prior_rollup_state", "prior_archive_state"
      ],
      "properties": {
        "corpus_label": { "type": "string", "minLength": 1 },
        "owner_or_custodian": { "type": "string", "minLength": 1 },
        "authorized_operator": { "type": "string", "minLength": 1 },
        "reviewers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "approved_by": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "revoked": { "type": "boolean" },
        "allow_scratch_replay": { "type": "boolean" },
        "allow_aggregate_publication": { "type": "boolean" },
        "cleanup_deadline": { "type": "string", "format": "date-time" },
        "independence_rationale": { "type": "string", "minLength": 1 },
        "fixed_utc_anchor": { "type": "string", "format": "date-time" },
        "retention_window_days": { "type": "integer", "minimum": 1 },
        "quill_stopped_acknowledged": { "const": true },
        "concurrent_load_policy": { "type": "string", "minLength": 1 },
        "prior_prune_state": { "type": "string", "minLength": 1 },
        "prior_rollup_state": { "type": "string", "minLength": 1 },
        "prior_archive_state": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "inventory": {
      "type": "object",
      "required": ["source_path", "schema_version", "page_size", "page_count", "files"],
      "properties": {
        "source_path": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "integer", "minimum": 0 },
        "page_size": { "type": "integer", "minimum": 1 },
        "page_count": { "type": "integer", "minimum": 0 },
        "files": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/file" } }
      },
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "required": ["label", "present", "bytes", "sha256", "identity"],
      "properties": {
        "label": { "type": "string" },
        "present": { "type": "boolean" },
        "bytes": { "type": ["integer", "null"], "minimum": 0 },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "identity": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "backup": {
      "type": "object",
      "required": ["scratch_path", "pages", "page_size", "elapsed_ms", "integrity_check"],
      "properties": {
        "scratch_path": { "type": "string" },
        "pages": { "type": "integer", "minimum": 0 },
        "page_size": { "type": "integer", "minimum": 1 },
        "elapsed_ms": { "type": "integer", "minimum": 0 },
        "integrity_check": { "const": "ok" }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": ["archive_mode", "cache_state", "run_ordinal", "status", "backup", "timing", "cancellation", "cleanup", "failure"],
      "properties": {
        "archive_mode": { "enum": ["archive_off", "archive_on"] },
        "cache_state": { "enum": ["controlled_warm", "best_effort_cold"] },
        "run_ordinal": { "type": "integer", "minimum": 1, "maximum": 3 },
        "status": { "enum": ["completed", "failed", "cancelled", "missing"] },
        "backup": { "$ref": "#/$defs/backup_evidence" },
        "timing": { "$ref": "#/$defs/timing_evidence" },
        "cancellation": { "$ref": "#/$defs/cancellation" },
        "cleanup": { "$ref": "#/$defs/cleanup" },
        "failure": { "$ref": "#/$defs/failure_evidence" }
      },
      "additionalProperties": false
    },
    "backup_evidence": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "value", "reason_code"],
          "properties": { "status": { "const": "observed" }, "value": { "$ref": "#/$defs/backup" }, "reason_code": { "type": "null" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status", "value", "reason_code"],
          "properties": { "status": { "enum": ["missing", "not_applicable", "suppressed"] }, "value": { "type": "null" }, "reason_code": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        }
      ]
    },
    "timing": {
      "type": "object",
      "required": ["replay_elapsed_ms", "priming_elapsed_ms"],
      "properties": {
        "replay_elapsed_ms": { "type": "integer", "minimum": 0 },
        "priming_elapsed_ms": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "timing_evidence": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "value", "reason_code"],
          "properties": { "status": { "const": "observed" }, "value": { "$ref": "#/$defs/timing" }, "reason_code": { "type": "null" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status", "value", "reason_code"],
          "properties": { "status": { "enum": ["missing", "not_applicable", "suppressed"] }, "value": { "type": "null" }, "reason_code": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        }
      ]
    },
    "cancellation": {
      "type": "object",
      "required": ["requested", "phase"],
      "properties": {
        "requested": { "type": "boolean" },
        "phase": { "enum": ["not_requested", "before_start", "preflight", "backup", "migration", "priming", "timed_replay"] }
      },
      "additionalProperties": false
    },
    "cleanup": {
      "type": "object",
      "required": ["status", "scratch_removed", "archive_removed", "reason_code"],
      "properties": {
        "status": { "enum": ["completed", "failed", "not_applicable"] },
        "scratch_removed": { "type": "boolean" },
        "archive_removed": { "type": "boolean" },
        "reason_code": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": ["code"],
      "properties": { "code": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "failure_evidence": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "value", "reason_code"],
          "properties": { "status": { "const": "observed" }, "value": { "$ref": "#/$defs/failure" }, "reason_code": { "type": "null" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status", "value", "reason_code"],
          "properties": { "status": { "enum": ["missing", "not_applicable", "suppressed"] }, "value": { "type": "null" }, "reason_code": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        }
      ]
    }
  }
}
